# ─────────────────────────────────────────────────────────────
# GBX SiteEval — environment configuration
# Copy this file to `.env` and fill in any keys you want to use.
# EVERYTHING WORKS WITH NO KEYS AT ALL. Keys only add extra depth.
# ─────────────────────────────────────────────────────────────

# Server port
PORT=3000

# ── Optional: Claude API (qualitative messaging & copy critique) ──
# Adds an "Editorial" read of the site's positioning, clarity and
# call-to-action strength, written in GBX plain-language tone.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Optional: Google PageSpeed Insights (real Core Web Vitals) ──
# Replaces the on-page performance heuristics with lab + field data.
# Get a key at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ── Optional: Web search (real online-presence signal) ──
# Measures how discoverable the brand is beyond its own site.
# Supported providers: "serpapi" or "brave".
SEARCH_PROVIDER=
SEARCH_API_KEY=
