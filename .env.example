# ─────────────────────────────────────────────────────────────
# GBX SiteEval — environment configuration
# Copy this file to `.env` and fill in any keys you want to use.
# EVERYTHING WORKS WITH NO KEYS AT ALL. Keys only add extra depth.
# ─────────────────────────────────────────────────────────────

# Server port
PORT=3000

# ── Lead-gen mode ──
# When on, the full scorecard, action plan and PDF are gated behind an email
# capture. Captured leads are appended to data/leads.jsonl.
# Values: on / off  (default off)
LEADGEN_MODE=off

# Optional path to a Chromium/Chrome binary for server-side PDF generation.
# If unset, the app looks for a system Chrome; if none is found it falls back
# to the browser "print to PDF" view. Leave blank on most setups.
CHROMIUM_PATH=

# ── Optional: Claude API (qualitative messaging & copy critique) ──
# Adds an "Editorial" read of the site's positioning, clarity and
# call-to-action strength, written in GBX plain-language tone.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Optional: Google PageSpeed Insights (real Core Web Vitals) ──
# Replaces the on-page performance heuristics with lab + field data.
# Get a key at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ── Optional: Web search (real online-presence signal) ──
# Powers the "How you show up in search" section: the real top results for the
# brand name, classified (your site / social / directory / third-party) with
# highlights, plus indexed & orphan-page detection.
#
# FREE OPTION — SerpApi free tier (100 searches/month, no card):
#   1. Sign up:  https://serpapi.com/users/sign_up
#   2. Get key:  https://serpapi.com/manage-api-key
#   3. Set the two lines below. Each report uses 2 searches (~50 reports/month).
# Supported providers: "serpapi" or "brave".
SEARCH_PROVIDER=
SEARCH_API_KEY=
# Optional: point serpapi at a self-hosted/proxy/mock endpoint (advanced).
SEARCH_ENDPOINT=
